{
  "components": {
    "schemas": {
      "AgentCreateRequest": {
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "model_name": {
            "default": "local-echo",
            "title": "Model Name",
            "type": "string"
          },
          "model_provider": {
            "$ref": "#/components/schemas/ModelProvider",
            "default": "local"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/AgentRole"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "title": "AgentCreateRequest",
        "type": "object"
      },
      "AgentExecuteRequest": {
        "properties": {
          "instruction": {
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "AgentExecuteRequest",
        "type": "object"
      },
      "AgentRole": {
        "description": "六个内置 Agent 角色（主规格 §6.1）。",
        "enum": [
          "tech_lead",
          "architect",
          "developer",
          "reviewer",
          "tester",
          "devops"
        ],
        "title": "AgentRole",
        "type": "string"
      },
      "BrainSection": {
        "description": "Project Brain 的记忆分区（主规格 §5.6；实施计划 ⑪）。\n\n前四个是\"项目现状\"型分区，每区只保留一份最新内容（重新写入即覆盖）；\n后两个是\"累积\"型分区，每次写入都新增一条，历史不可被覆盖。",
        "enum": [
          "overview",
          "tech_stack",
          "architecture",
          "coding_rules",
          "decisions",
          "agent_notes"
        ],
        "title": "BrainSection",
        "type": "string"
      },
      "Capability": {
        "description": "Capability 权限项（主规格 §5.5 / §8.4）。",
        "enum": [
          "file.read",
          "file.write",
          "terminal.execute",
          "github.create_pr",
          "browser.open",
          "deploy",
          "secret.access",
          "device.command"
        ],
        "title": "Capability",
        "type": "string"
      },
      "ChangeIdsRequest": {
        "properties": {
          "change_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Change Ids",
            "type": "array"
          }
        },
        "required": [
          "change_ids"
        ],
        "title": "ChangeIdsRequest",
        "type": "object"
      },
      "ChatMessageIn": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "pattern": "^(system|user|assistant)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageIn",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageIn"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "provider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ConnectorExecuteRequest": {
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "connector": {
            "minLength": 1,
            "title": "Connector",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "connector",
          "action"
        ],
        "title": "ConnectorExecuteRequest",
        "type": "object"
      },
      "GenerateProposalsRequest": {
        "description": "让 Developer Agent 依据一句需求产出提案（⑫ 最小 IDE 的\"让 AI 改\"）。\n\npaths 是需求相关的文件（相对工作区根）；服务端只读这些文件的现状当作上下文，\n产出的是待审阅提案，不会写任何用户文件。paths 为空表示不携带上下文。",
        "properties": {
          "instruction": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "title": "Paths",
            "type": "array"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "GenerateProposalsRequest",
        "type": "object"
      },
      "GitCheckoutRequest": {
        "properties": {
          "create": {
            "default": false,
            "title": "Create",
            "type": "boolean"
          },
          "target": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "target"
        ],
        "title": "GitCheckoutRequest",
        "type": "object"
      },
      "GitCommitRequest": {
        "description": "提交改动。message 由调用方给出（用户可改），Agent 无权直接决定提交信息。",
        "properties": {
          "change_ids": {
            "items": {
              "type": "string"
            },
            "title": "Change Ids",
            "type": "array"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "paths": {
            "items": {
              "type": "string"
            },
            "title": "Paths",
            "type": "array"
          }
        },
        "required": [
          "message"
        ],
        "title": "GitCommitRequest",
        "type": "object"
      },
      "GitDiffRequest": {
        "description": "查看差异。paths 为空表示整个工作区。",
        "properties": {
          "paths": {
            "items": {
              "type": "string"
            },
            "title": "Paths",
            "type": "array"
          },
          "staged": {
            "default": false,
            "title": "Staged",
            "type": "boolean"
          }
        },
        "title": "GitDiffRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MemoryWriteRequest": {
        "description": "写一条项目记忆。分区语义见 flux.enums.BrainSection。",
        "properties": {
          "content": {
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "section": {
            "$ref": "#/components/schemas/BrainSection"
          }
        },
        "required": [
          "section",
          "content"
        ],
        "title": "MemoryWriteRequest",
        "type": "object"
      },
      "ModelProvider": {
        "description": "模型供应商（主规格 §5.3 裁决 A4）。",
        "enum": [
          "openai",
          "anthropic",
          "deepseek",
          "local"
        ],
        "title": "ModelProvider",
        "type": "string"
      },
      "ProjectCreateRequest": {
        "description": "登记一个项目（⑪ Project Brain 的宿主实体）。",
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "repository": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repository"
          }
        },
        "required": [
          "name"
        ],
        "title": "ProjectCreateRequest",
        "type": "object"
      },
      "RejectRequest": {
        "properties": {
          "change_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Change Ids",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "change_ids"
        ],
        "title": "RejectRequest",
        "type": "object"
      },
      "ScanRequest": {
        "description": "扫描被登记项目的工作区目录（⑩）。\n\nworkspace_root 留空表示用服务端配置的 FLUX_WORKSPACE_ROOT；record=false\n时只返回画像，不把结果写进 Project Brain。",
        "properties": {
          "record": {
            "default": true,
            "title": "Record",
            "type": "boolean"
          },
          "workspace_root": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workspace Root"
          }
        },
        "title": "ScanRequest",
        "type": "object"
      },
      "TaskCreateRequest": {
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "priority": {
            "default": 100,
            "title": "Priority",
            "type": "integer"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          }
        },
        "required": [
          "description"
        ],
        "title": "TaskCreateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Flux 后端 API（主规格 §12）",
    "title": "Flux",
