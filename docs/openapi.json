{
  "components": {
    "schemas": {
      "AgentCreateRequest": {
        "properties": {
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "model_name": {
            "default": "local-echo",
            "title": "Model Name",
            "type": "string"
          },
          "model_provider": {
            "$ref": "#/components/schemas/ModelProvider",
            "default": "local"
          },
          "name": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "items": {
              "$ref": "#/components/schemas/Capability"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/AgentRole"
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "title": "Skills",
            "type": "array"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "title": "AgentCreateRequest",
        "type": "object"
      },
      "AgentExecuteRequest": {
        "properties": {
          "instruction": {
            "minLength": 1,
            "title": "Instruction",
            "type": "string"
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "instruction"
        ],
        "title": "AgentExecuteRequest",
        "type": "object"
      },
      "AgentRole": {
        "description": "六个内置 Agent 角色（主规格 §6.1）。",
        "enum": [
          "tech_lead",
          "architect",
          "developer",
          "reviewer",
          "tester",
          "devops"
        ],
        "title": "AgentRole",
        "type": "string"
      },
      "Capability": {
        "description": "Capability 权限项（主规格 §5.5 / §8.4）。",
        "enum": [
          "file.read",
          "file.write",
          "terminal.execute",
          "github.create_pr",
          "browser.open",
          "deploy",
          "secret.access",
          "device.command"
        ],
        "title": "Capability",
        "type": "string"
      },
      "ChangeIdsRequest": {
        "properties": {
          "change_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Change Ids",
            "type": "array"
          }
        },
        "required": [
          "change_ids"
        ],
        "title": "ChangeIdsRequest",
        "type": "object"
      },
      "ChatMessageIn": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "pattern": "^(system|user|assistant)$",
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageIn",
        "type": "object"
      },
      "ChatRequest": {
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageIn"
            },
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "provider": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModelProvider"
              },
              {
                "type": "null"
              }
            ]
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ConnectorExecuteRequest": {
        "properties": {
          "action": {
            "minLength": 1,
            "title": "Action",
            "type": "string"
          },
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "connector": {
            "minLength": 1,
            "title": "Connector",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "connector",
          "action"
        ],
        "title": "ConnectorExecuteRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelProvider": {
        "description": "模型供应商（主规格 §5.3 裁决 A4）。",
        "enum": [
          "openai",
          "anthropic",
          "deepseek",
          "local"
        ],
        "title": "ModelProvider",
        "type": "string"
      },
      "RejectRequest": {
        "properties": {
          "change_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "title": "Change Ids",
            "type": "array"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "required": [
          "change_ids"
        ],
        "title": "RejectRequest",
        "type": "object"
      },
      "TaskCreateRequest": {
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "priority": {
            "default": 100,
            "title": "Priority",
            "type": "integer"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          }
        },
        "required": [
          "description"
        ],
        "title": "TaskCreateRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
