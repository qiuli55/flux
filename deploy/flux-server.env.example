# Flux 服务端实例的环境变量模板（对应 deploy/flux-server.service）
#
# 部署时复制到 /opt/flux/server/flux-server.env 并 chmod 600；
# 真实文件**不入库**（.gitignore 已含 *.env 之外，具体见仓库根 .gitignore）。
# 唯一的必填项是 FLUX_AUTH_TOKEN：公网可达的实例不能没有它。

# --- 鉴权（必填）---
# 生成：openssl rand -hex 24
FLUX_AUTH_TOKEN=<用 openssl rand -hex 24 生成，不要用示例值>

# --- 基本 ---
FLUX_ENV=server
FLUX_LOG_LEVEL=INFO

# --- 存储（绝对路径；sqlite 绝对路径是 4 个斜杠）---
FLUX_DATABASE_URL=sqlite+aiosqlite:////opt/flux/server/flux.db

# --- Agent 改动落盘根目录（= 手机上审核提案后真正被改的那个项目）---
FLUX_WORKSPACE_ROOT=/root/workspace/flux-login-app
# 落盘后要跑的测试命令（留空跳过）；在 workspace_root 下执行
FLUX_TEST_COMMAND=pytest -q

# --- 内置 Agent Runtime（Solo / 任务执行靠它）---
FLUX_DSH_ENABLED=true
FLUX_DSH_HOME=/opt/flux/server/dsh-home
FLUX_DSH_WORKSPACE=/opt/flux/server/dsh-ws
# Agent 经 MCP 反查项目事实与提交提案，端点必须指向本实例自己的端口
FLUX_DSH_MCP_URL=http://127.0.0.1:8801/mcp