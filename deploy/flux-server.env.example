# Flux 服务端实例的环境变量模板（对应 deploy/flux-server.service）
#
# 部署时复制到 /opt/flux/server/flux-server.env 并 chmod 600；
# 真实文件**不入库**（.gitignore 已含 *.env 之外，具体见仓库根 .gitignore）。
#
# 公网可达的实例必须配置 FLUX_AUTH_TOKEN（server / 非回环监听下留空会直接拒绝启动）。
# 若还要让「官方 Web」通过账号云登录，则**额外**需要下列之一：
#   1) FLUX_CLOUD_ALLOWED_USERS：允许登录本实例的账号 user id（逗号分隔）；
#   2) 先在本机回环（或带 FLUX_AUTH_TOKEN）完成一次登录，把该账号绑定为本机主人
#      （落盘到 FLUX_CLOUD_OWNER_FILE，默认 ~/.flux/cloud-owner.json）。
# 注意：公网官方 Web 请求不带 FLUX_AUTH_TOKEN，**无法自行完成首次绑定**。
# 升级说明：旧的 ~/.flux/cloud.json 会话**不会**在启动时自动升为本机主人——#41 修复前
# 未鉴权的公网登录可以把任意账号写进该服务器单例，残留会话不能证明主人身份。
# 从当前 main 升级时，请二选一完成绑定：配置 FLUX_CLOUD_ALLOWED_USERS；或在本机回环
# （或带 FLUX_AUTH_TOKEN）再登录一次，完成本机主人绑定。公网官方 Web 无法自行完成首次绑定。

# --- 鉴权（必填）---
# 生成：openssl rand -hex 24
FLUX_AUTH_TOKEN=<用 openssl rand -hex 24 生成，不要用示例值>

# --- 账号云登录（公网官方 Web 必读）---
# 与账号云共享的 HS256 密钥；留空 = 不认账号云令牌，只保留 FLUX_AUTH_TOKEN / 回环直连。
# FLUX_CLOUD_SECRET_KEY=<与账号云一致的共享密钥，不要写进仓库>
# 允许登录本实例的账号 user id（对应 access token 的 sub），逗号 / 分号 / 空白分隔。
# 与「本机绑定主人」是"或"的关系；两者都没有时公网官方 Web 登录会返回明确错误而不是静默循环。
# FLUX_CLOUD_ALLOWED_USERS=
# FLUX_CLOUD_BASE_URL=https://flux.qiuli55.top
# 登录完成后回跳的工作台地址（账号云登录页以 ?next= 携带）。
# FLUX_CLOUD_RETURN_URL=https://你的实例域名/
# 本机绑定主人 / 服务器单例会话的落盘位置（0600，按需覆盖）。
# FLUX_CLOUD_OWNER_FILE=/root/.flux/cloud-owner.json
# FLUX_CLOUD_SESSION_FILE=/root/.flux/cloud.json

# --- 基本 ---
FLUX_ENV=server
FLUX_LOG_LEVEL=INFO

# --- 存储（绝对路径；sqlite 绝对路径是 4 个斜杠）---
FLUX_DATABASE_URL=sqlite+aiosqlite:////opt/flux/server/flux.db

# --- Agent 改动落盘根目录（= 手机上审核提案后真正被改的那个项目）---
FLUX_WORKSPACE_ROOT=/root/workspace/flux-login-app
# 落盘后要跑的测试命令（留空跳过）；在 workspace_root 下执行
FLUX_TEST_COMMAND=pytest -q

# --- 内置 Agent Runtime（Solo / 任务执行靠它）---
FLUX_DSH_ENABLED=true
FLUX_DSH_HOME=/opt/flux/server/dsh-home
FLUX_DSH_WORKSPACE=/opt/flux/server/dsh-ws
# Agent 经 MCP 反查项目事实与提交提案，端点必须指向本实例自己的端口
FLUX_DSH_MCP_URL=http://127.0.0.1:8801/mcp

# --- MCP 查询参数令牌（默认关闭）---
# MCP 默认只接受 Authorization: Bearer 头。若外部连接器只能把令牌填进 URL，需显式打开；
# 打开后查询参数会进入反向代理 / 浏览器访问日志，请先评估泄露风险。
# FLUX_MCP_ALLOW_QUERY_TOKEN=true

# --- 密钥库（API Key Vault）---
# Agent 模型通道的 API Key 加密落库。主密钥生产建议显式配置并备份：
#   openssl rand -hex 32
# 留空 = 首次启动自动生成 /root/.flux/key-vault.key（0600）；丢失后已存 key 只能重新录入。
# FLUX_KEY_VAULT_SECRET=