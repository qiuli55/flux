<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flux.Desktop.ViewModels"
             xmlns:views="using:Flux.Desktop.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1320" d:DesignHeight="900"
             x:Class="Flux.Desktop.Views.DesignsView"
             x:DataType="vm:DesignsViewModel"
             KeyDown="OnViewKeyDown">

    <UserControl.Resources>
        <!-- 左侧设计稿卡片 -->
        <DataTemplate x:Key="DesignCardTemplate" x:DataType="vm:DesignCard">
            <Button Classes="kb-card design-card" Padding="10" Margin="0,0,0,8"
                    Classes.active="{Binding IsSelected}"
                    Command="{Binding OpenCommand}"
                    CommandParameter="{Binding}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Width="52" Height="72" CornerRadius="6"
                            Background="#FF07090A" ClipToBounds="True">
                        <views:DesignCanvas Width="52" Height="72" IsThumbnail="True"
                                            Preview="{Binding Preview}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaText}" FontSize="10.5"
                                   Foreground="{DynamicResource TnText4}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UpdatedText}" Classes="mono" FontSize="10"
                                   Foreground="{DynamicResource TnText4}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 画板页签 -->
        <DataTemplate x:Key="ScreenTabTemplate" x:DataType="vm:DesignScreenTab">
            <Button Classes="seg" Classes.active="{Binding IsActive}" Margin="0,0,2,0"
                    Content="{Binding Label}"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{Binding}" />
        </DataTemplate>

        <!-- AI 变更行 -->
        <DataTemplate x:Key="AiChangeTemplate" x:DataType="vm:DesignAiChangeView">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,3,0,0">
                <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding Tone}"
                         VerticalAlignment="Top" Margin="0,4,0,0" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TnText4}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="9.5"
                           Foreground="{DynamicResource TnText4}" VerticalAlignment="Top" />
            </Grid>
        </DataTemplate>

        <!-- 历史版本行 -->
        <DataTemplate x:Key="RevisionTemplate" x:DataType="vm:DesignRevisionView">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,5,0,0">
                <TextBlock Grid.Column="0" Text="{Binding Label}" Classes="mono" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource TnText2}" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding MetaText}" FontSize="10.5"
                               Foreground="{DynamicResource TnText4}" />
                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                               Foreground="{DynamicResource TnText4}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="mini" Content="恢复" VerticalAlignment="Center"
                        Command="{Binding RestoreCommand}" CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.design-card.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TnAccentLine}" />
            <Setter Property="Background" Value="{DynamicResource TnAccentSoft}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="24,24,28,24" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0">
                <TextBlock Classes="page-title" Text="设计" Margin="0,0,0,5" />
                <TextBlock Classes="page-desc" MaxWidth="760" HorizontalAlignment="Left"
                           Text="打开 Luma 设计稿看整屏效果，用一句话让 AI 改结构，改坏了随时回到历史版本。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Hint}" FontSize="11"
                           Foreground="{DynamicResource TnText4}" VerticalAlignment="Center" />
                <Button Classes="btn subtle" Content="编辑画布" Command="{Binding ToggleCanvasEditingCommand}"
                        IsVisible="{Binding !IsCanvasEditing}" />
                <Button Classes="btn subtle" Content="退出编辑" Command="{Binding ToggleCanvasEditingCommand}"
                        IsVisible="{Binding IsCanvasEditing}" />
                <Button Classes="btn subtle" Content="导入"
                        Click="OnImportClick" IsEnabled="{Binding !IsBusy}" />
                <Button Classes="btn subtle" Content="导出 SVG"
                        Click="OnExportClick" IsEnabled="{Binding HasDesign}" />
                <Button Classes="btn subtle" Content="网页预览"
                        Command="{Binding PreviewCommand}" IsEnabled="{Binding HasDesign}" />
                <Button Classes="btn subtle" Content="刷新"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="248,*,300" ColumnSpacing="14">

            <!-- 设计稿列表 -->
            <Border Grid.Column="0" Classes="card" Padding="10">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="section-title" Text="设计稿" Margin="4,2,0,8" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Designs}"
                                      ItemTemplate="{StaticResource DesignCardTemplate}" />
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="还没有设计稿" FontSize="11" Margin="4,8,0,0"
                               Foreground="{DynamicResource TnText4}"
                               IsVisible="{Binding !HasDesigns}" />
                </Grid>
            </Border>

            <!-- 画布 -->
            <Border Grid.Column="1" Classes="card" Padding="14">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Meta}" Classes="mono" FontSize="10.5"
                                       Foreground="{DynamicResource TnText4}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Bottom"
                                    HorizontalAlignment="Right">
                            <TextBlock Text="{Binding MetaDetail}" FontSize="10.5"
                                       Foreground="{DynamicResource TnText4}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                       MaxWidth="260" />
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        HorizontalAlignment="Right"
                                        IsVisible="{Binding IsCanvasEditing}">
                                <Button Classes="mini" Content="撤销"
                                        Command="{Binding UndoEditCommand}"
                                        IsEnabled="{Binding CanUndo}" />
                                <Button Classes="mini" Content="重做"
                                        Command="{Binding RedoEditCommand}"
                                        IsEnabled="{Binding CanRedo}" />
                                <Button Classes="mini" Content="保存"
                                        Command="{Binding SaveCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        IsVisible="{Binding HasUnsavedChanges}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,10"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Screens}"
                                      ItemTemplate="{StaticResource ScreenTabTemplate}"
                                      IsVisible="{Binding HasScreens}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#FF07090A" CornerRadius="10"
                            ClipToBounds="True">
                        <Grid>
                            <views:DesignCanvas Document="{Binding Document}"
                                                PreviewDocument="{Binding PreviewDocument}"
                                                Highlights="{Binding Highlights}"
                                                IsAiBusy="{Binding IsAiBusy}"
                                                IsEditing="{Binding IsCanvasEditing}"
                                                ScreenIndex="{Binding ActiveScreenIndex}"
                                                ScreenRequested="OnCanvasScreenRequested"
                                                EditStarted="OnCanvasEditStarted"
                                                FramesCommitted="OnCanvasFramesCommitted"
                                                DeleteRequested="OnCanvasDeleteRequested"
                                                SelectionChanged="OnCanvasSelectionChanged"
                                                UndoRequested="OnCanvasUndoRequested"
                                                RedoRequested="OnCanvasRedoRequested"
                                                IsVisible="{Binding HasDesign}" />
                            <TextBlock Text="{Binding CanvasHint}" FontSize="10.5"
                                       Foreground="#99FFFFFF" IsHitTestVisible="False"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       Margin="12" TextWrapping="Wrap" MaxWidth="520" />
                            <StackPanel Spacing="6" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" IsVisible="{Binding !HasDesign}">
                                <TextBlock Text="从左侧选一份设计稿" FontSize="12"
                                           Foreground="{DynamicResource TnText3}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="也可以点右上角刷新重新拉取列表" FontSize="10.5"
                                           Foreground="{DynamicResource TnText4}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 右栏：AI 与历史 -->
            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14">
                    <!-- 选中图层：与手机轻编辑对齐的桌面属性面板 -->
                    <Border Classes="card" Padding="14" IsVisible="{Binding HasCanvasSelection}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title" Text="选中图层" />
                            <TextBlock Text="{Binding SelectedNodeLabel}" FontSize="11.5"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="多选时可在画布上整体拖动；单选可改属性。"
                                       FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TnText4}"
                                       IsVisible="{Binding NodeMulti}" />
                            <StackPanel Spacing="6" IsVisible="{Binding HasNodeSelection}">
                                <TextBox Classes="compose" Text="{Binding NodeText}"
                                         Watermark="文案（留空不改）" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                      RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="X" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeX}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Y" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeY}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="宽" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeW}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="高" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeH}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="填充色" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeFill}" Watermark="#FFFFFF" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="文字色" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeColor}" Watermark="#0F172A" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="描边色（none 表示去掉）" FontSize="10"
                                               Foreground="{DynamicResource TnText4}" />
                                    <TextBox Classes="compose" Text="{Binding NodeStroke}" Watermark="#0891B2" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="字号" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeFontSize}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="圆角" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeRadius}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="不透明度" FontSize="10" Foreground="{DynamicResource TnText4}" />
                                        <TextBox Classes="compose" Text="{Binding NodeOpacity}" Watermark="0–1" />
                                    </StackPanel>
                                </Grid>
                                <Button Classes="btn primary" Content="应用修改"
                                        Command="{Binding ApplyNodeEditsCommand}" />
                                <Button Classes="btn subtle" Content="删除选中图层"
                                        Command="{Binding DeleteSelectedNodeCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="section-title" Text="AI 修改" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TnText4}"
                                       Text="先生成变更预览与高亮，确认后再写入画布；应用后仍可撤销或保存。" />
                            <TextBox Classes="compose" MinHeight="68" MaxHeight="140"
                                     Text="{Binding AiPrompt}"
                                     Watermark="例如：把标题放大，副标题颜色变浅"
                                     IsEnabled="{Binding !IsAiBusy}" />
                            <Button Classes="btn primary" Content="让 AI 改"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding AskCommand}"
                                    IsEnabled="{Binding !IsAiBusy}" />

                            <!-- 过程面板：阶段 + 已用时 + 取消 -->
                            <TextBlock Text="{Binding AiState}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TnAccent}"
                                       IsVisible="{Binding AiState, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding AiElapsedText}" FontSize="10.5"
                                       Foreground="{DynamicResource TnText4}"
                                       IsVisible="{Binding AiElapsedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Button Classes="btn subtle" Content="取消这次修改"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CancelAiCommand}"
                                    IsVisible="{Binding IsAiBusy}" />

                            <!-- 变更清单：确认后才应用到真源 -->
                            <Border Background="{DynamicResource TnAccentSoft}" CornerRadius="8"
                                    Padding="8" IsVisible="{Binding HasAiPreview}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="变更预览" FontSize="11" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding AiChanges}"
                                                  ItemTemplate="{StaticResource AiChangeTemplate}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                        <Button Classes="btn primary" Content="应用全部"
                                                Command="{Binding ApplyAiCommand}"
                                                IsEnabled="{Binding !IsAiApplying}" />
                                        <Button Classes="btn subtle" Content="取消"
                                                Command="{Binding CancelAiCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding AiReply}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TnText3}"
                                       IsVisible="{Binding AiReply, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <StackPanel Orientation="Horizontal" Spacing="8"
                                        IsVisible="{Binding HasUnsavedChanges}">
                                <Button Classes="btn primary" Content="保存"
                                        Command="{Binding SaveCommand}"
                                        IsEnabled="{Binding !IsBusy}" />
                                <Button Classes="btn subtle" Content="撤销 AI 修改"
                                        Command="{Binding UndoAiCommand}"
                                        IsEnabled="{Binding !IsBusy}"
                                        IsVisible="{Binding HasUnsavedAi}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="section-title" Text="历史版本" />
                            <TextBlock FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TnText4}"
                                       Text="每次保存都会留一份快照，恢复会生成新版本，不会删掉记录。" />
                            <ItemsControl ItemsSource="{Binding Revisions}"
                                          ItemTemplate="{StaticResource RevisionTemplate}" />
                            <TextBlock Text="还没有历史版本" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{DynamicResource TnText4}"
                                       IsVisible="{Binding !HasRevisions}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
