<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Flux.Desktop.Views.FluxSwitch"
             Width="38" Height="22" Cursor="Hand">

    <!-- 对齐 web 端 .fx-switch：38×22 胶囊轨道 + 16px 圆形滑块，零渐变零阴影 -->
    <UserControl.Styles>
        <Style Selector="Border#Track">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource TnPanel3}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TnLine}" />
        </Style>
        <Style Selector="Border#Track.on">
            <Setter Property="Background" Value="{DynamicResource TnAccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TnAccentLine}" />
        </Style>
        <Style Selector="Ellipse#Knob">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Fill" Value="{DynamicResource TnText3}" />
        </Style>
        <Style Selector="Ellipse#Knob.on">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Fill" Value="{DynamicResource TnAccent}" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="Track">
        <Ellipse x:Name="Knob" />
    </Border>
</UserControl>
