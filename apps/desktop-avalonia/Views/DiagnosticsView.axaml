<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flux.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="Flux.Desktop.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

    <UserControl.Resources>
        <!-- 健康瓦片（web 端 fx-health-tile） -->
        <DataTemplate x:Key="TileTemplate" DataType="vm:HealthTileView">
            <Border Classes="card pad">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource TnAccent}" IsVisible="{Binding Ok}" />
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                 Fill="{DynamicResource TnWarn}" IsVisible="{Binding !Ok}" />
                        <TextBlock Text="{Binding Label}" FontSize="12"
                                   Foreground="{DynamicResource TnText3}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Desc}" FontSize="11"
                               Foreground="{DynamicResource TnText4}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 键值行 -->
        <DataTemplate x:Key="KvTemplate" DataType="vm:KvView">
            <Grid ColumnDefinitions="110,*" Margin="0,0,0,12">
                <TextBlock Text="{Binding Key}" FontSize="12"
                           Foreground="{DynamicResource TnText3}" />
                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>

        <!-- Agent 运行时行 -->
        <DataTemplate x:Key="AgentTemplate" DataType="vm:AgentRowView">
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8">
                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="badge" BorderBrush="{Binding RuntimeTone}" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Runtime}" FontSize="11" Foreground="{Binding RuntimeTone}" />
                </Border>
                <Border Grid.Column="2" Classes="badge" BorderBrush="{Binding StateTone}">
                    <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding StateTone}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 本机 CLI 安装行（web 端 fx-set-row） -->
        <DataTemplate x:Key="InstallTemplate" DataType="vm:InstallRowView">
            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TnText4}" />
                        <TextBlock Text="{Binding Adapter}" FontSize="12"
                                   Foreground="{DynamicResource TnText4}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PathText}" FontSize="11"
                               Foreground="{DynamicResource TnText4}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Border Classes="badge" BorderBrush="{Binding AuthTone}">
                        <TextBlock Text="{Binding AuthLabel}" FontSize="11" Foreground="{Binding AuthTone}" />
                    </Border>
                    <Border Classes="badge" BorderBrush="{Binding StatusTone}">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{Binding StatusTone}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="32,32,40,32">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                    <TextBlock Classes="page-title" Text="系统诊断" Margin="0,0,0,5" />
                    <TextBlock Classes="page-desc" MaxWidth="760" HorizontalAlignment="Left"
                               Text="后端健康、就绪状态、DSH 运行时与本机 CLI 安装的实时快照。" />
                </StackPanel>
                <Button Grid.Column="1" Classes="btn subtle" Content="刷新"
                        VerticalAlignment="Bottom"
                        Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <!-- 三块健康瓦片 -->
            <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}"
                          Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- DSH 接线 / Agent 运行时 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Classes="card pad">
                    <StackPanel>
                        <TextBlock Classes="section-title" Text="DSH 接线" />
                        <ItemsControl ItemsSource="{Binding DshRows}" Margin="0,12,0,0"
                                      ItemTemplate="{StaticResource KvTemplate}"
                                      IsVisible="{Binding HasDsh}" />
                        <TextBlock Text="未获取到 DSH 状态" FontSize="12" Margin="0,16"
                                   Foreground="{DynamicResource TnText4}"
                                   IsVisible="{Binding !HasDsh}" />
                        <ItemsControl ItemsSource="{Binding Providers}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="badge" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource TnInfo}">
                                        <TextBlock Text="{Binding}" FontSize="11"
                                                   Foreground="{DynamicResource TnInfo}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="card pad">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="section-title" Text="Agent 运行时" />
                            <TextBlock Grid.Column="1" Text="{Binding AgentCountText}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TnText4}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Agents}" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource AgentTemplate}" />
                        <TextBlock Text="没有注册的 Agent" FontSize="12" Margin="0,16"
                                   Foreground="{DynamicResource TnText4}"
                                   IsVisible="{Binding HasNoAgents}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 本机 CLI 安装 -->
            <Border Classes="card pad" Margin="0,16,0,0">
                <StackPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="section-title" Text="本机 CLI 安装" />
                        <TextBlock Grid.Column="1" Text="{Binding InstallCountText}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TnText4}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Installs}"
                                  ItemTemplate="{StaticResource InstallTemplate}" />
                    <TextBlock Text="未发现本机 CLI Agent" FontSize="12" Margin="0,16"
                               Foreground="{DynamicResource TnText4}"
                               IsVisible="{Binding HasNoInstalls}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
