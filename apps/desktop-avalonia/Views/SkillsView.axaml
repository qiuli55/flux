<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flux.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="Flux.Desktop.Views.SkillsView"
             x:DataType="vm:SkillsViewModel">

    <UserControl.Resources>
        <!-- 已导入能力卡片（web 端 fx-market-card） -->
        <DataTemplate x:Key="CapCardTemplate" DataType="vm:SkillCardView">
            <Border Classes="card pad" Margin="0,0,16,16" Width="260">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="6"
                                Background="{DynamicResource TnPanel2}"
                                BorderBrush="{DynamicResource TnLine}" BorderThickness="1">
                            <Viewbox Width="16" Height="16" Stretch="Uniform">
                                <Path Data="{Binding Icon}" Width="24" Height="24" Stretch="None"
                                      Stroke="{DynamicResource TnText2}" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeJoin="Round" />
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding VersionText}" FontSize="11"
                                       Foreground="{DynamicResource TnText4}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Source}" FontSize="12" Height="36"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TnText3}" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Classes="badge" BorderBrush="{Binding Tone}">
                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{Binding Tone}" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="11"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TnText4}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 扫描来源行 -->
        <DataTemplate x:Key="ScanSourceTemplate" DataType="vm:ScanSourceView">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                <Border Grid.Column="0" Classes="badge" BorderBrush="{Binding Tone}">
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{Binding Tone}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="mono" FontSize="11"
                           Margin="8,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TnText4}" />
                <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource TnText4}" />
            </Grid>
        </DataTemplate>

        <!-- 扫描候选行（web 端 fx-set-row） -->
        <DataTemplate x:Key="ScanCandidateTemplate" DataType="vm:ScanCandidateView">
            <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                <StackPanel Grid.Column="0" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                        <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource TnText4}" />
                        <TextBlock Text="{Binding KindLabel}" FontSize="12"
                                   Foreground="{DynamicResource TnText4}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source}" FontSize="11"
                               Foreground="{DynamicResource TnText4}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding BlockedReason}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TnDanger}"
                               IsVisible="{Binding Blocked}" />
                </StackPanel>
                <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource TnDanger}"
                        IsVisible="{Binding Blocked}">
                    <TextBlock Text="已拦截" FontSize="11" Foreground="{DynamicResource TnDanger}" />
                </Border>
                <Button Grid.Column="1" Classes="btn subtle" Content="导入" VerticalAlignment="Center"
                        Command="{Binding Import}" IsVisible="{Binding CanImport}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <ScrollViewer>
            <StackPanel Margin="32,32,40,32">

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Grid.Column="0">
                        <TextBlock Classes="page-title" Text="Skills" Margin="0,0,0,5" />
                        <TextBlock Classes="page-desc" MaxWidth="760" HorizontalAlignment="Left"
                                   Text="集中管理可用能力：Agent 档案、Skill 能力包与 Connector。扫描本机来源目录，安全导入可复用能力。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                VerticalAlignment="Bottom">
                        <Button Classes="btn subtle" Content="刷新"
                                Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
                        <Button Classes="btn primary" Content="扫描导入"
                                Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />
                    </StackPanel>
                </Grid>

                <!-- 工具条：筛选项 + 计数 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                    <Border BorderBrush="{DynamicResource TnLine}" BorderThickness="1" CornerRadius="6"
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="seg" Classes.active="{Binding IsAll}" Content="全部"
                                    Command="{Binding SelectFilterCommand}" CommandParameter="all" />
                            <Button Classes="seg" Classes.active="{Binding IsAgent}" Content="Agent"
                                    Command="{Binding SelectFilterCommand}" CommandParameter="agent" />
                            <Button Classes="seg" Classes.active="{Binding IsSkill}" Content="Skill"
                                    Command="{Binding SelectFilterCommand}" CommandParameter="skill" />
                            <Button Classes="seg" Classes.active="{Binding IsConnector}" Content="Connector"
                                    Command="{Binding SelectFilterCommand}" CommandParameter="connector" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TnText4}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TnAccent}" />
                </StackPanel>

                <!-- 空态 -->
                <Border Classes="card" IsVisible="{Binding HasNoCards}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="24,48">
                        <Border Classes="badge" HorizontalAlignment="Center">
                            <TextBlock Text="暂无已导入能力" FontSize="11"
                                       Foreground="{DynamicResource TnText4}" />
                        </Border>
                        <TextBlock Text="点击「扫描导入」从本机来源目录发现能力" FontSize="12"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TnText4}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CapCardTemplate}"
                              IsVisible="{Binding HasCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 扫描结果浮层（web 端 Modal large） -->
        <Border IsVisible="{Binding IsReportOpen}">
            <Panel>
                <Border Background="{DynamicResource TnScrim}" />
                <Border Width="820" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="{DynamicResource TnPanel}"
                        BorderBrush="{DynamicResource TnLine}" BorderThickness="1" CornerRadius="10">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <Border Grid.Row="0" Padding="16"
                                BorderBrush="{DynamicResource TnLine}" BorderThickness="0,0,0,1">
                            <TextBlock Text="扫描结果" FontSize="14" FontWeight="SemiBold" />
                        </Border>

                        <ScrollViewer Grid.Row="1" Padding="16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                                    <Border Classes="badge" BorderBrush="{DynamicResource TnLine}">
                                        <TextBlock Text="{Binding TotalBadge}" FontSize="11"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </Border>
                                    <Border Classes="badge" BorderBrush="{DynamicResource TnAccent}">
                                        <TextBlock Text="{Binding OkBadge}" FontSize="11"
                                                   Foreground="{DynamicResource TnAccent}" />
                                    </Border>
                                    <Border Classes="badge" BorderBrush="{DynamicResource TnDanger}">
                                        <TextBlock Text="{Binding BlockedBadge}" FontSize="11"
                                                   Foreground="{DynamicResource TnDanger}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasSources}" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding ScanSources}"
                                                  ItemTemplate="{StaticResource ScanSourceTemplate}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding ScanCandidates}"
                                              ItemTemplate="{StaticResource ScanCandidateTemplate}" />
                                <TextBlock Text="没有发现候选能力" FontSize="12" Margin="0,16"
                                           Foreground="{DynamicResource TnText4}"
                                           IsVisible="{Binding HasNoCandidates}" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    Spacing="12" Margin="16">
                            <Button Classes="btn" Content="完成" Command="{Binding CloseReportCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Panel>
        </Border>
    </Panel>
</UserControl>
