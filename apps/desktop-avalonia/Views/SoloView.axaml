<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Flux.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Flux.Desktop.Views.SoloView"
             x:DataType="vm:SoloViewModel">

    <UserControl.Resources>
        <!-- 改动卡：右侧工作区列表与单 Agent 本轮改动条共用 -->
        <DataTemplate x:Key="ChangeCard" DataType="vm:ChangeRow">
            <Border Background="{DynamicResource TnBg2}" BorderBrush="{DynamicResource TnLine}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                    <Button Classes="btn quiet" Padding="0" HorizontalContentAlignment="Stretch"
                            Cursor="Hand" Command="{Binding ToggleCommand}" CommandParameter="{Binding}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding FilePath}" FontSize="11"
                                       FontFamily="{DynamicResource TnMonoFont}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding StateText}" FontSize="10"
                                           Foreground="{Binding StateBrush}" />
                                <TextBlock Text="{Binding AddText}" FontSize="10"
                                           Foreground="{DynamicResource TnAccent}" />
                                <TextBlock Text="{Binding DelText}" FontSize="10"
                                           Foreground="{DynamicResource TnDanger}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Classes="mini" HorizontalAlignment="Left" Content="{Binding ActionText}"
                            Command="{Binding ReviewCommand}" CommandParameter="{Binding}"
                            IsVisible="{Binding CanReview}" />
                    <Border IsVisible="{Binding IsExpanded}" Background="#05070A" CornerRadius="6"
                            Padding="6" MaxHeight="260">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiffLineRow">
                                        <TextBlock Text="{Binding Text}" FontSize="10"
                                                   FontFamily="{DynamicResource TnMonoFont}"
                                                   Foreground="{Binding Foreground}"
                                                   Background="{Binding Background}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 流水线对话气泡 -->
        <DataTemplate x:Key="MessageCard" DataType="vm:MessageRow">
            <Border Classes="bubble" Classes.user="{Binding IsUser}" Margin="0,0,0,8">
                <StackPanel Spacing="5">
                    <TextBlock Text="前情摘要 · 来自上一段对话" FontSize="10"
                               Foreground="{DynamicResource TnInfo}"
                               IsVisible="{Binding IsSummary}" />
                    <TextBlock Text="{Binding Meta}" FontSize="10"
                               Foreground="{DynamicResource TnText4}" />
                    <TextBlock Text="{Binding Content}" FontSize="12" LineHeight="19"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 单 Agent 对话气泡 -->
        <DataTemplate x:Key="AgentTurnCard" DataType="vm:AgentTurnRow">
            <Border Classes="bubble" Classes.user="{Binding IsUser}" Margin="0,0,0,8">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Author}" FontSize="10"
                                   Foreground="{DynamicResource TnText4}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding RunStatus}" FontSize="10"
                                       Foreground="{DynamicResource TnInfo}"
                                       IsVisible="{Binding IsRunning}" />
                            <TextBlock Text="{Binding Meta}" FontSize="10"
                                       Foreground="{DynamicResource TnText4}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Text}" FontSize="12" LineHeight="19"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="230,*,316" Background="{DynamicResource TnBg}">

        <!-- ===================== 左：任务列表 ===================== -->
        <Border Grid.Column="0" Classes="solo-side" Padding="12,14">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="caps" Text="任务" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="mini" Content="新建"
                            Command="{Binding NewTaskCommand}" />
                </Grid>
                <TextBlock Grid.Row="1" Text="选择任务继续，或新建一条需求"
                           FontSize="10" Foreground="{DynamicResource TnText4}"
                           Margin="2,8,0,0" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskRow">
                                <Button Classes="task-row" Classes.active="{Binding IsActive}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                        Command="{Binding SelectCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="5" HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       TextWrapping="Wrap" MaxLines="2" />
                                            <Ellipse Grid.Column="1" Width="6" Height="6"
                                                     Fill="{Binding StatusBrush}"
                                                     VerticalAlignment="Top" Margin="6,5,0,0" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Meta}" FontSize="10"
                                                       FontFamily="{DynamicResource TnMonoFont}"
                                                       Foreground="{DynamicResource TnText4}" />
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                       FontSize="10" Foreground="{Binding StatusBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Row="3" Classes="btn quiet" HorizontalAlignment="Left"
                        Content="打开项目列表" Margin="0,10,0,0"
                        Command="{Binding OpenProjectsCommand}" />
            </Grid>
        </Border>

        <!-- ===================== 中：工作区 ===================== -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- 页头 -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,14">
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding TaskTitle}" FontSize="17" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="badge" BorderBrush="{Binding StatusBrush}">
                            <TextBlock Text="{Binding StatusText}" FontSize="10"
                                       Foreground="{Binding StatusBrush}" />
                        </Border>
                        <TextBlock Text="{Binding TaskMeta}" FontSize="11"
                                   Foreground="{DynamicResource TnText4}" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Classes="pill" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Classes="seg" Classes.active="{Binding IsPipeline}" Content="流水线"
                                Command="{Binding SwitchToPipelineCommand}" />
                        <Button Classes="seg" Classes.active="{Binding IsSoloAgent}" Content="单 Agent"
                                Command="{Binding SwitchToAgentCommand}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 流水线模式 -->
            <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsPipeline}">
                <ScrollViewer Grid.Row="0">
                    <StackPanel Margin="20,0,20,12" Spacing="12">

                        <Border Classes="solo-card" IsVisible="{Binding IsNewTask}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="从一条需求开始" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Classes="page-desc"
                                           Text="发送后 Flux 会建任务并先做需求澄清；确认六个维度后才会执行。执行中的每个改动都可以回滚。" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Border Classes="pill">
                                        <TextBlock Text="自动决策" FontSize="10"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </Border>
                                    <Border Classes="pill">
                                        <TextBlock Text="六维确认" FontSize="10"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </Border>
                                    <Border Classes="pill">
                                        <TextBlock Text="改动可回滚" FontSize="10"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 七步流程 -->
                        <Border Classes="solo-card">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="caps" Text="执行流程" />
                                        <TextBlock Text="{Binding StepText}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="mini" Content="取消执行"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsRunning}"
                                            Command="{Binding CancelTaskCommand}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FlowSteps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FlowStepRow">
                                            <Grid ColumnDefinitions="22,*,Auto" Height="26">
                                                <Border Width="16" Height="16" CornerRadius="8"
                                                        Background="{Binding DotBrush}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Marker}" FontSize="9"
                                                               Foreground="#050608"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{Binding TextBrush}" />
                                                <TextBlock Grid.Column="2" Text="当前" FontSize="10"
                                                           Foreground="{DynamicResource TnInfo}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding IsActive}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 六维确认 -->
                        <Border Classes="solo-card" IsVisible="{Binding HasConfirmation}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="caps" Text="需求确认 · 六维" />
                                        <TextBlock Text="{Binding ConfirmationActorText}" FontSize="11"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Classes="mini" Content="保存确认"
                                                Command="{Binding SaveConfirmationCommand}" />
                                        <Button Classes="mini" Content="开始执行"
                                                Command="{Binding StartTaskCommand}" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding ConfirmationItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ConfirmationEdit">
                                            <Grid ColumnDefinitions="96,*" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Label}" FontSize="11"
                                                           Foreground="{DynamicResource TnText3}"
                                                           VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Classes="input" Height="30"
                                                         Text="{Binding Value, Mode=TwoWay}"
                                                         IsEnabled="{Binding $parent[ItemsControl].DataContext.IsConfirmationEditable}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ConfirmationHint}" FontSize="10"
                                           Foreground="{DynamicResource TnText4}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 决策卡 -->
                        <Border Classes="solo-card" IsVisible="{Binding HasPendingDecision}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="caps" Text="需要你的决策" />
                                <TextBlock Text="{Binding DecisionQuestion}" FontSize="13"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DecisionContext}" FontSize="11"
                                           Foreground="{DynamicResource TnText3}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DecisionHint}" FontSize="11"
                                           Foreground="{DynamicResource TnWarn}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding DecisionOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DecisionOptionRow">
                                            <Button Classes="btn subtle" Margin="0,0,0,6"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Command="{Binding ChooseCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                                        <Border Classes="kb-tag"
                                                                IsVisible="{Binding IsRecommended}">
                                                            <TextBlock Text="{Binding Badge}" FontSize="10"
                                                                       Foreground="{DynamicResource TnAccent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="{DynamicResource TnText3}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Impact}" FontSize="10"
                                                               Foreground="{DynamicResource TnText4}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Classes="input" Height="32"
                                         Text="{Binding DecisionNote, Mode=TwoWay}"
                                         Watermark="补充说明（可留空）" />
                                <Button Classes="btn quiet" HorizontalAlignment="Left"
                                        Content="都不接受，请重新给方案"
                                        Command="{Binding RejectDecisionCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- 对话 -->
                        <Border Classes="solo-card">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="caps" Text="任务对话" />
                                    <TextBlock Grid.Column="1" FontSize="10"
                                               Foreground="{DynamicResource TnText4}"
                                               Text="{Binding StrategyText}" />
                                </Grid>
                                <!-- 上下文占用：平台助手这一轮实际能带上的历史，不是模型标称窗口 -->
                                <StackPanel Spacing="3" IsVisible="{Binding HasContextUsage}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Text="上下文" FontSize="10"
                                                   Foreground="{DynamicResource TnText4}"
                                                   VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="3" Margin="8,0"
                                                     Minimum="0" Maximum="100"
                                                     Value="{Binding ContextUsage.Percent}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ContextPercentText}"
                                                   FontSize="10"
                                                   FontFamily="{DynamicResource TnMonoFont}"
                                                   Foreground="{DynamicResource TnText3}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ContextHintText}" FontSize="9"
                                               Foreground="{DynamicResource TnText4}" />
                                </StackPanel>
                                <!-- 从上一段对话接手：只带摘要，不搬旧消息 -->
                                <Border IsVisible="{Binding HasPendingSummary}"
                                        Background="#0C1B22" BorderBrush="#1F4E5A"
                                        BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="前情摘要 · 来自上一段对话" FontSize="10"
                                                   Foreground="{DynamicResource TnInfo}" />
                                        <ScrollViewer MaxHeight="110">
                                            <TextBlock Text="{Binding PendingSummary}" FontSize="11"
                                                       LineHeight="18" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TnText2}" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Name="ChatScroll" MaxHeight="420">
                                    <ItemsControl ItemsSource="{Binding Messages}"
                                                  ItemTemplate="{StaticResource MessageCard}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 输入框 -->
                <Border Grid.Row="1" Padding="20,10,20,16"
                        BorderBrush="{DynamicResource TnLine}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="6">
                        <!-- 上下文将满：就在输入框上方问一句，不打断当前对话 -->
                        <Border IsVisible="{Binding ContextPromptVisible}"
                                Background="#221A0B" BorderBrush="#5A4218"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="上下文快满了" FontSize="11"
                                               FontWeight="SemiBold" Foreground="#E8B25E" />
                                    <TextBlock Grid.Column="1" Text="{Binding ContextPercentText}"
                                               FontSize="10" FontFamily="{DynamicResource TnMonoFont}"
                                               Foreground="#E8B25E" />
                                </Grid>
                                <TextBlock Text="{Binding ContextPromptDetail}" FontSize="10"
                                           Foreground="{DynamicResource TnText3}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="mini" Content="继续聊"
                                            Command="{Binding ContinueContextCommand}" />
                                    <Button Classes="mini" Content="新建并带摘要"
                                            Command="{Binding StartHandoffCommand}"
                                            IsEnabled="{Binding !IsHandoffBusy}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ConfirmationHint}" FontSize="10"
                                   Foreground="{DynamicResource TnText4}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Classes="compose" Text="{Binding Draft, Mode=TwoWay}"
                                     Watermark="描述需求或继续对话…" />
                            <Button Grid.Column="1" Classes="btn primary" Content="发送"
                                    Height="62" Margin="10,0,0,0" Width="88"
                                    Command="{Binding SendCommand}"
                                    IsEnabled="{Binding !IsSending}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 单 Agent 模式 -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding IsSoloAgent}">
                <Border Grid.Row="0" Padding="20,0,20,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Classes="select" Width="190"
                                      ItemsSource="{Binding AgentChoices}"
                                      SelectedItem="{Binding SelectedAgent, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgentChoice">
                                        <TextBlock Text="{Binding Label}" FontSize="11" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox Classes="select" Width="250"
                                      ItemsSource="{Binding ModelChoices}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModelChoice">
                                        <TextBlock Text="{Binding Label}" FontSize="11" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="mini" Content="{Binding AutoApplyText}"
                                    Command="{Binding ToggleAutoApplyCommand}" />
                            <Button Classes="mini" Content="清空"
                                    Command="{Binding ClearAgentChatCommand}" />
                            <Button Classes="mini" Content="停止"
                                    IsVisible="{Binding AgentBusy}"
                                    Command="{Binding StopAgentCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Name="AgentScroll">
                    <StackPanel Margin="20,0,20,8" Spacing="8">
                        <Border Classes="solo-card" IsVisible="{Binding !HasAgentTurns}">
                            <StackPanel Spacing="5">
                                <TextBlock Text="直接跟 Agent 干活" FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Classes="page-desc"
                                           Text="这条通道不经流水线：发给选中的 Agent，执行完把本轮改动交给你保留或撤销。会话会按任务复用。" />
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding AgentTurns}"
                                      ItemTemplate="{StaticResource AgentTurnCard}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 本轮改动 -->
                <Border Grid.Row="2" Classes="solo-card" Padding="12" Margin="20,0,20,8"
                        IsVisible="{Binding HasRound}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="btn quiet" HorizontalContentAlignment="Left"
                                    Padding="0" Command="{Binding ToggleRoundCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="本轮改动" FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RoundFilesText}" FontSize="11"
                                               Foreground="{DynamicResource TnText3}" />
                                    <TextBlock Text="{Binding RoundAddText}" FontSize="11"
                                               Foreground="{DynamicResource TnAccent}" />
                                    <TextBlock Text="{Binding RoundDelText}" FontSize="11"
                                               Foreground="{DynamicResource TnDanger}" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="mini" Content="保留"
                                        Command="{Binding KeepRoundCommand}" />
                                <Button Classes="mini" Content="撤销"
                                        Command="{Binding UndoRoundCommand}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RoundItems}"
                                      ItemTemplate="{StaticResource ChangeCard}"
                                      IsVisible="{Binding RoundExpanded}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Padding="20,0,20,16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding AgentHint}" FontSize="10"
                                   Foreground="{DynamicResource TnText4}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Classes="compose" Text="{Binding AgentInput, Mode=TwoWay}"
                                     Watermark="给 Agent 的指令…" />
                            <Button Grid.Column="1" Classes="btn primary" Content="发送"
                                    Height="62" Margin="10,0,0,0" Width="88"
                                    Command="{Binding SendAgentCommand}"
                                    IsEnabled="{Binding !AgentBusy}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== 右：项目与改动 ===================== -->
        <Border Grid.Column="2" Background="{DynamicResource TnBg2}"
                BorderBrush="{DynamicResource TnLine}" BorderThickness="1,0,0,0">
            <ScrollViewer>
                <StackPanel Margin="14" Spacing="12">
                    <Border Classes="solo-card">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caps" Text="当前项目" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Classes="mini" Content="全部"
                                        Command="{Binding OpenProjectsCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ProjectName}" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ProjectRepo}" FontSize="10"
                                       FontFamily="{DynamicResource TnMonoFont}"
                                       Foreground="{DynamicResource TnText3}" TextWrapping="Wrap" />
                            <Rectangle Classes="rule-soft" Margin="0,4" />
                            <TextBlock Classes="caps" Text="工作区" />
                            <TextBlock Text="{Binding WorkspaceText}" FontSize="10"
                                       FontFamily="{DynamicResource TnMonoFont}"
                                       Foreground="{DynamicResource TnText4}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Classes="solo-card">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="caps" Text="工作区改动" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding ChangesSummary}"
                                           FontSize="10" Foreground="{DynamicResource TnText4}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Changes}"
                                          ItemTemplate="{StaticResource ChangeCard}" />
                            <TextBlock Text="暂无改动" FontSize="11"
                                       Foreground="{DynamicResource TnText4}"
                                       IsVisible="{Binding !HasChanges}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
