# Flux Cloud 环境变量模板
# 部署：sudo install -m 600 -o root -g root flux-cloud.env.example /etc/flux-cloud.env
# 改完执行：sudo systemctl restart flux-cloud

# 运行环境标识，仅用于日志与 /health 展示
FLUX_CLOUD_ENV=prod

# 对外地址：OAuth 回调、Cookie、跳转都以它为准，必须是 HTTPS 正式域名
FLUX_CLOUD_PUBLIC_BASE_URL=https://flux.qiuli55.top

# 数据目录：SQLite 库 + 用户上传的日志包
FLUX_CLOUD_DATA_DIR=/var/lib/flux-cloud

# 令牌签名密钥：必须换成随机值，例如
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
FLUX_CLOUD_SECRET_KEY=

# 令牌有效期
FLUX_CLOUD_ACCESS_TTL_MIN=30
FLUX_CLOUD_REFRESH_TTL_DAYS=30

# Cookie：生产必须为 1（仅 HTTPS 下发）；子域共享时填 .qiuli55.top
FLUX_CLOUD_COOKIE_SECURE=1
FLUX_CLOUD_COOKIE_DOMAIN=

# GitHub OAuth App（回调：https://flux.qiuli55.top/api/auth/oauth/github/callback）
FLUX_CLOUD_GITHUB_CLIENT_ID=
FLUX_CLOUD_GITHUB_CLIENT_SECRET=

# Google OAuth 客户端（Web 类型，回调：https://flux.qiuli55.top/api/auth/oauth/google/callback）
FLUX_CLOUD_GOOGLE_CLIENT_ID=
FLUX_CLOUD_GOOGLE_CLIENT_SECRET=

# 单个日志包上限（MB）
FLUX_CLOUD_MAX_LOG_MB=64

# 允许调用 API 的前端来源，逗号分隔；* 表示反射任意 Origin（桌面端需要）
FLUX_CLOUD_ALLOW_ORIGINS=*
