# Flux Cloud —— 登录 / 日志上传服务
# 安装位置：/etc/systemd/system/flux-cloud.service
# 依赖：/etc/flux-cloud.env（0600 root）与 /opt/flux-cloud/venv

[Unit]
Description=Flux Cloud (account + run-log upload service)
Documentation=https://flux.qiuli55.top
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/flux-cloud
EnvironmentFile=/etc/flux-cloud.env
ExecStart=/opt/flux-cloud/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8500 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --no-server-header
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
