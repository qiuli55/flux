<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v2 浅色主题：与 demo `flux-mobile-v2` 的 #eef1f5 / #f4f6f9 对齐，
         用 XML 主题钉住启动窗口和系统栏，避免启动瞬间闪深色。 -->
    <style name="Theme.FluxMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#eef1f5</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">#eef1f5</item>
    </style>
</resources>
