<?xml version="1.0" encoding="utf-8"?>
<!--
  内嵌浏览器预览 Demo 时，只对 A 机与 B 机两个固定内网地址放行明文 HTTP；
  其余域名仍按系统默认（target 28+ 禁止明文），不扩大明文范围。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">159.75.222.60</domain>
        <domain includeSubdomains="false">115.159.125.254</domain>
    </domain-config>
</network-security-config>
