<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连服务端（HTTPS）用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内更新：下载完 APK 后调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 交互触感：轻点 / 成功 / 驳回 / 失败四级反馈，受设置开关控制 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 决策 / 任务完成提醒（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 用前台服务在用户离开聊天后继续关注进行中的任务（无 FCM，只能本机监听） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".FluxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FluxMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- 明文 HTTP 默认关闭：应用在本地保存访问令牌，走 http 等于把令牌与终端输出
             暴露在同一网段上。服务端（flux.qiuli55.top）是 HTTPS，不需要明文。
             唯一例外见 network_security_config.xml：A 机 / B 机的固定 IP 允许明文，
             供内嵌浏览器预览本机部署的 HTML Demo。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FluxMobile"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 系统分享：文字 / 链接 / 单张图片 / 单个文件，落到输入栏草稿。
                 显式列出常见类型，最后用 */* 兜底，避免文件管理器分享普通文件时看不到 Flux；
                 解析时仍会校验可读性、大小（50MB）和数量（5 个）。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/uri-list" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- 系统分享：多文件（相册多选 / 文件管理器多选） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
                <data android:mimeType="text/uri-list" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-powerpoint" />
                <data android:mimeType="application/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- Flux 云账号 OAuth 回跳：flux://auth?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flux" android:host="auth" />
            </intent-filter>
            <!-- 链接 GitHub 仓库权限的回跳：flux://github-link?code=&state= -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flux" android:host="github-link" />
            </intent-filter>
        </activity>

        <!-- 应用级任务提醒：轮询 /tasks，发现等待决策或任务结束时发系统通知。
             只有还有进行中的任务时才启动，任务全部结束后自行停止。 -->
        <service
            android:name=".notify.TaskAlertService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 更新包通过 FileProvider 交给系统安装器，不暴露应用私有目录的其他文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>