<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连服务端（HTTPS）用 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 应用内更新：下载完 APK 后调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 交互触感：轻点 / 成功 / 驳回 / 失败四级反馈，受设置开关控制 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".FluxApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FluxMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">
        <!-- 明文 HTTP 默认关闭：应用在本地保存访问令牌，走 http 等于把令牌与终端输出
             暴露在同一网段上。服务端（flux.qiuli55.top）是 HTTPS，不需要明文。
             唯一例外见 network_security_config.xml：A 机 / B 机的固定 IP 允许明文，
             供内嵌浏览器预览本机部署的 HTML Demo。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FluxMobile"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- GitHub OAuth 回跳：flux://auth?code=... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="flux" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- 更新包通过 FileProvider 交给系统安装器，不暴露应用私有目录的其他文件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>

</manifest>