<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug source-set override.

  The debug APK is the artifact installed on devices (signed with the distribution
  certificate), so this file must be a strict superset of the main
  res/xml/network_security_config.xml: it adds the local test hosts used for
  emulator end-to-end checks but must never drop the production cleartext hosts.

  Regression guard: NetworkSecurityConfigTest compares every <domain> in the main
  config against this file and fails the build if one is missing.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Keep in sync with app/src/main/res/xml/network_security_config.xml -->
        <domain includeSubdomains="false">159.75.222.60</domain>
        <domain includeSubdomains="false">115.159.125.254</domain>
        <!-- Local audit backend: Android emulator host loopback + adb reverse. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
