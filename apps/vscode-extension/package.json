{
  "name": "flux-vscode",
  "displayName": "Flux",
  "description": "在 VS Code / VSCodium 中接入 Flux 平台：项目、任务与 Agent 对话",
  "version": "0.1.0",
  "publisher": "flux",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:fluxTasks",
    "onView:fluxProjects",
    "onView:fluxChanges",
    "onCommand:flux.newTask",
    "onCommand:flux.refresh",
    "onCommand:flux.setServer",
    "onCommand:flux.healthCheck",
    "onCommand:flux.openChangeDiff",
    "onCommand:flux.acceptChanges",
    "onCommand:flux.rejectChanges",
    "onCommand:flux.applyChanges",
    "onCommand:flux.rollbackChange",
    "onCommand:flux.restartLanguageServer",
    "onCommand:flux.showLanguageServers",
    "onCommand:flux.completion.toggle",
    "onCommand:flux.completion.selfCheck",
    "onCommand:flux.spec.draft",
    "onCommand:flux.openTask",
    "onCommand:flux.openTaskPanel",
    "onCommand:flux.quickMenu",
    "onCommand:flux.openSettings"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flux",
          "title": "Flux",
          "icon": "media/flux.svg"
        }
      ]
    },
    "views": {
      "flux": [
        {
          "id": "fluxProjects",
          "name": "项目"
        },
        {
          "id": "fluxTasks",
          "name": "任务"
        },
        {
          "id": "fluxChanges",
          "name": "提案"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "fluxProjects",
        "contents": "还没有从 Flux 读取到项目。\n[新建任务](command:flux.newTask)\n[检查连接](command:flux.healthCheck)\n后端地址不对时，运行 [设置服务器地址](command:flux.setServer)。"
      },
      {
        "view": "fluxTasks",
        "contents": "这里会列出所选项目的任务。\n[新建任务](command:flux.newTask)\n[选择项目](command:flux.pickProject)"
      },
      {
        "view": "fluxChanges",
        "contents": "没有待处理的提案。\nAgent 产出的改动会出现在这里，可以逐条查看差异、接受或拒绝。\n刷新可点右上角 ⟳，或按 Ctrl+Alt+F 打开快捷菜单。"
      }
    ],
    "commands": [
      {
        "command": "flux.quickMenu",
        "title": "快捷菜单",
        "category": "Flux",
        "icon": "$(zap)"
      },
      {
        "command": "flux.newTask",
        "title": "新建任务",
        "category": "Flux",
        "icon": "$(add)"
      },
      {
        "command": "flux.openTaskPanel",
        "title": "打开任务面板…",
        "category": "Flux",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "flux.openTask",
        "title": "打开任务",
        "category": "Flux"
      },
      {
        "command": "flux.refresh",
        "title": "刷新",
        "category": "Flux",
        "icon": "$(refresh)"
      },
      {
        "command": "flux.pickProject",
        "title": "选择项目",
        "category": "Flux",
        "icon": "$(folder)"
      },
      {
        "command": "flux.selectProject",
        "title": "切换到此项目",
        "category": "Flux",
        "icon": "$(folder-active)"
      },
      {
        "command": "flux.setServer",
        "title": "设置服务器地址",
        "category": "Flux"
      },
      {
        "command": "flux.healthCheck",
        "title": "检查连接",
        "category": "Flux"
      },
      {
        "command": "flux.openChangeDiff",
        "title": "查看提案差异",
        "category": "Flux"
      },
      {
        "command": "flux.acceptChanges",
        "title": "接受提案",
        "category": "Flux",
        "icon": "$(check)"
      },
      {
        "command": "flux.rejectChanges",
        "title": "拒绝提案",
        "category": "Flux",
        "icon": "$(circle-slash)"
      },
      {
        "command": "flux.applyChanges",
        "title": "应用提案",
        "category": "Flux",
        "icon": "$(check-all)"
      },
      {
        "command": "flux.rollbackChange",
        "title": "回滚已应用变更",
        "category": "Flux",
        "icon": "$(history)"
      },
      {
        "command": "flux.restartLanguageServer",
        "title": "重启语言服务",
        "category": "Flux",
        "icon": "$(debug-restart)"
      },
      {
        "command": "flux.showLanguageServers",
        "title": "语言服务器…",
        "category": "Flux",
        "icon": "$(server-process)"
      },
      {
        "command": "flux.completion.toggle",
        "title": "开关 AI 补全",
        "category": "Flux",
        "icon": "$(sparkle)"
      },
      {
        "command": "flux.completion.selfCheck",
        "title": "补全自检",
        "category": "Flux",
        "icon": "$(pulse)"
      },
      {
        "command": "flux.spec.draft",
        "title": "与 Agent 确认需求文档",
        "category": "Flux",
        "icon": "$(book)"
      },
      {
        "command": "flux.openSettings",
        "title": "打开设置",
        "category": "Flux",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flux.newTask",
          "when": "view == fluxTasks",
          "group": "navigation"
        },
        {
          "command": "flux.refresh",
          "when": "view == fluxTasks || view == fluxProjects || view == fluxChanges",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flux.acceptChanges",
          "when": "view == fluxChanges && viewItem == fluxChange.pending",
          "group": "inline@1"
        },
        {
          "command": "flux.rejectChanges",
          "when": "view == fluxChanges && viewItem == fluxChange.pending",
          "group": "inline@2"
        },
        {
          "command": "flux.applyChanges",
          "when": "view == fluxChanges && viewItem == fluxChange.accepted",
          "group": "inline@1"
        },
        {
          "command": "flux.rollbackChange",
          "when": "view == fluxChanges && viewItem == fluxChange.applied",
          "group": "inline@1"
        },
        {
          "command": "flux.selectProject",
          "when": "view == fluxProjects && viewItem == fluxProject",
          "group": "inline@1"
        },
        {
          "command": "flux.openTaskPanel",
          "when": "view == fluxTasks && viewItem == fluxTask",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "flux.newTask",
          "when": "resourceScheme == file",
          "group": "flux@1"
        }
      ],
      "editor/context": [
        {
          "command": "flux.spec.draft",
          "when": "editorTextFocus",
          "group": "flux@1"
        }
      ],
      "commandPalette": [
        {
          "command": "flux.selectProject",
          "when": "false"
        },
        {
          "command": "flux.openTask",
          "when": "false"
        },
        {
          "command": "flux.openChangeDiff",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "flux.quickMenu",
        "key": "ctrl+alt+f",
        "mac": "cmd+alt+f"
      },
      {
        "command": "flux.newTask",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "flux.openTaskPanel",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "flux.completion.toggle",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "themes": [
      {
        "label": "Flux Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/flux-dark-color-theme.json"
      }
    ],
    "colors": [
      {
        "id": "flux.accent",
        "description": "Flux 主强调色（Terminal Noir 电光青绿）",
        "defaults": {
          "dark": "#3df5a8",
          "light": "#0f9d6b",
          "highContrast": "#3df5a8",
          "highContrastLight": "#0f9d6b"
        }
      },
      {
        "id": "flux.info",
        "description": "Flux 信息色",
        "defaults": {
          "dark": "#7fb6e0",
          "light": "#2563a8",
          "highContrast": "#7fb6e0",
          "highContrastLight": "#2563a8"
        }
      },
      {
        "id": "flux.warn",
        "description": "Flux 警告色",
        "defaults": {
          "dark": "#e8b25e",
          "light": "#9a6a10",
          "highContrast": "#e8b25e",
          "highContrastLight": "#9a6a10"
        }
      },
      {
        "id": "flux.danger",
        "description": "Flux 危险色",
        "defaults": {
          "dark": "#ff7a6e",
          "light": "#b3261e",
          "highContrast": "#ff7a6e",
          "highContrastLight": "#b3261e"
        }
      },
      {
        "id": "flux.muted",
        "description": "Flux 次级/弱化文字色",
        "defaults": {
          "dark": "#6c7674",
          "light": "#6b7472",
          "highContrast": "#9ca6a4",
          "highContrastLight": "#4a5250"
        }
      }
    ],
    "configurationDefaults": {
      "workbench.colorTheme": "Flux Dark",
      "workbench.preferredDarkColorTheme": "Flux Dark",
      "workbench.preferredLightColorTheme": "Flux Dark",
      "window.autoDetectColorScheme": false,
      "window.autoDetectHighContrast": false,
      "workbench.startupEditor": "none",
      "workbench.tips.enabled": false,
      "workbench.enableExperiments": false,
      "workbench.list.smoothScrolling": true,
      "workbench.editor.tabSizing": "shrink",
      "workbench.editor.decorations.badges": true,
      "workbench.tree.indent": 14,
      "workbench.tree.renderIndentGuides": "onHover",
      "breadcrumbs.enabled": true,
      "editor.fontFamily": "'JetBrains Mono', 'SF Mono', 'Cascadia Code', Menlo, Consolas, 'Noto Sans Mono CJK SC', monospace",
      "editor.fontSize": 13,
      "editor.fontLigatures": true,
      "editor.lineHeight": 1.7,
      "editor.letterSpacing": 0.2,
      "editor.cursorBlinking": "smooth",
      "editor.cursorSmoothCaretAnimation": "on",
      "editor.smoothScrolling": true,
      "editor.renderWhitespace": "selection",
      "editor.renderLineHighlight": "all",
      "editor.guides.indentation": true,
      "editor.bracketPairColorization.enabled": true,
      "editor.guides.bracketPairs": "active",
      "editor.stickyScroll.enabled": true,
      "editor.minimap.enabled": true,
      "editor.minimap.renderCharacters": false,
      "editor.minimap.maxColumn": 100,
      "editor.occurrencesHighlight": "singleFile",
      "editor.selectionHighlight": true,
      "editor.padding.top": 12,
      "editor.padding.bottom": 12,
      "editor.scrollBeyondLastLine": true,
      "editor.suggest.preview": true,
      "editor.inlineSuggest.enabled": true,
      "editor.inlineSuggest.showToolbar": "onHover",
      "editor.linkedEditing": true,
      "editor.formatOnPaste": false,
      "files.trimTrailingWhitespace": true,
      "files.insertFinalNewline": true,
      "files.trimFinalNewlines": true,
      "terminal.integrated.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
      "terminal.integrated.fontSize": 12,
      "terminal.integrated.lineHeight": 1.35,
      "terminal.integrated.cursorStyle": "line",
      "terminal.integrated.cursorBlinking": true,
      "terminal.integrated.smoothScrolling": true,
      "explorer.compactFolders": false,
      "explorer.decorations.badges": true,
      "scm.diffDecorations": "gutter"
    },
    "configuration": {
      "title": "Flux",
      "properties": {
        "flux.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Flux 后端地址（不含 /api/v1）"
        },
        "flux.token": {
          "type": "string",
          "default": "",
          "description": "Flux 访问令牌（Bearer），对应服务端 FLUX_AUTH_TOKEN"
        },
        "flux.projectId": {
          "type": "string",
          "default": "",
          "description": "默认项目 ID；不填则按当前工作区匹配或使用第一个项目"
        },
        "flux.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用代码智能：补全、悬停、跳转定义、重命名、诊断、语义高亮等，由 Flux 后端统一管理语言服务器进程"
        },
        "flux.completion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 AI 行内补全（ghost text）。关闭后不注册补全 provider，不产生任何模型调用"
        },
        "flux.completion.debounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 2000,
          "description": "输入停顿多久后触发补全（毫秒）"
        },
        "flux.completion.maxLines": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 64,
          "description": "单次补全最多保留多少行，多出的部分由服务端截断"
        },
        "flux.completion.model": {
          "type": "string",
          "default": "follow-agent",
          "description": "补全使用的模型：follow-agent 跟随右栏当前 Agent；也可填 <keyId>::<model> 或裸模型名"
        },
        "flux.completion.mode": {
          "type": "string",
          "enum": [
            "insert",
            "line"
          ],
          "enumDescriptions": [
            "插入模式：从光标处续写，可跨多行",
            "整行模式：补全当前整行，只取一行，适合表格/配置等逐行输入场景"
          ],
          "default": "insert",
          "description": "补全形态：插入模式（默认）或整行模式"
        },
        "flux.completion.skipComments": {
          "type": "boolean",
          "default": true,
          "description": "在注释或字符串内部不触发补全（避免在注释里生成代码）"
        },
        "flux.completion.blockedPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "额外禁止外发补全的文件通配（如 **/*.sql、config/**）。内置规则（.env、*.pem、密钥、.git、lock 文件等）始终生效"
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --external:bufferutil --external:utf-8-validate --format=cjs --outfile=dist/extension.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/",
    "package": "vsce package --no-dependencies --out flux-vscode-0.1.0.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "ws": "^8.18.0"
  }
}
