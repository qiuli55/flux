{
  "$schema": "vscode://schemas/color-theme",
  "name": "Flux Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#7fb6e0",
    "type": "#3df5a8",
    "struct": "#3df5a8",
    "class": "#3df5a8",
    "enum": "#3df5a8",
    "interface": "#3df5a8",
    "typeParameter": "#3df5a8",
    "function": "#d7e6ff",
    "method": "#d7e6ff",
    "property": "#e7ecea",
    "property.readonly": "#e8b25e",
    "variable": "#e7ecea",
    "variable.readonly": "#e8b25e",
    "parameter": "#c7d2cf",
    "enumMember": "#e8b25e",
    "keyword": "#7fb6e0",
    "modifier": "#7fb6e0",
    "comment": "#5f6b69",
    "string": "#a8e6a3",
    "number": "#e8b25e",
    "regexp": "#e8b25e",
    "operator": "#9ca6a4",
    "decorator": "#e8b25e",
    "macro": "#e8b25e",
    "*deprecated": "#6c7674",
    "*": "#e7ecea"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5f6b69", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#7fb6e0" }
    },
    {
      "scope": ["keyword.operator", "operator", "punctuation.accessor"],
      "settings": { "foreground": "#9ca6a4" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "meta.type"],
      "settings": { "foreground": "#3df5a8" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call", "entity.name.function.member"],
      "settings": { "foreground": "#d7e6ff" }
    },
    {
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.object-literal.key", "variable.other.property"],
      "settings": { "foreground": "#e7ecea" }
    },
    {
      "scope": ["variable.parameter", "variable.parameter.function"],
      "settings": { "foreground": "#c7d2cf" }
    },
    {
      "scope": ["string", "string.quoted", "string.template", "meta.embedded.line"],
      "settings": { "foreground": "#a8e6a3" }
    },
    {
      "scope": ["string.regexp", "constant.other.character-class.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#e8b25e" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.character.escape"],
      "settings": { "foreground": "#e8b25e" }
    },
    {
      "scope": ["entity.name.tag", "meta.tag", "entity.name.tag.html", "meta.tag.any"],
      "settings": { "foreground": "#7fb6e0" }
    },
    {
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html"],
      "settings": { "foreground": "#3df5a8" }
    },
    {
      "scope": ["support.type.property-name", "support.type.property-name.json", "meta.structure.dictionary.json string.quoted.double.json"],
      "settings": { "foreground": "#7fb6e0" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace", "punctuation.section"],
      "settings": { "foreground": "#6c7674" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.import", "entity.name.import"],
      "settings": { "foreground": "#e8b25e" }
    },
    {
      "scope": ["annotation", "decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#e8b25e" }
    },
    {
      "scope": ["entity.name.namespace", "meta.namespace", "entity.name.scope-resolution"],
      "settings": { "foreground": "#7fb6e0" }
    },
    {
      "scope": ["markup.heading", "markup.heading entity.name"],
      "settings": { "foreground": "#3df5a8", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#e7ecea", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw.block"],
      "settings": { "foreground": "#a8e6a3" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#7fb6e0", "fontStyle": "underline" }
    },
    {
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "#3df5a8" }
    },
    {
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "#ff7a6e" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#e8b25e" }
    },
    {
      "scope": ["invalid", "invalid.illegal", "invalid.broken"],
      "settings": { "foreground": "#ff7a6e" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#6c7674", "fontStyle": "strikethrough" }
    }
  ],
