# AI Engineering OS 环境变量模板
# 复制为 .env 后填写，且必须放在仓库根：backend/aios/config.py 固定读取仓库根 .env，
# 与启动目录无关（make run 从仓库根启动、make migrate 从 backend/ 启动，读到的是同一份）。
# .env 已在 .gitignore 中，不会被提交。
# 注意：真实密钥只写进本地 .env 或 Vault，禁止写入源码与文档（主规格 §14.3）。

# --- 应用 ---
AIOS_ENV=local
AIOS_LOG_LEVEL=INFO
AIOS_API_V1_PREFIX=/api/v1

# --- 存储 ---
# 生产：PostgreSQL（部署时使用 pgvector 镜像，见 docker-compose.yml）
AIOS_DATABASE_URL=postgresql+asyncpg://aios:aios@localhost:5432/aios
# 本地无 PostgreSQL 时可用 SQLite 跑通（迁移与测试均支持）
# AIOS_DATABASE_URL=sqlite+aiosqlite:///./aios.db
AIOS_REDIS_URL=redis://localhost:6379/0

# --- 模型供应商（留空表示未配置，该供应商不参与路由）---
# 密钥仅在被调用的 Provider 内部读取，不下发给 Agent（主规格 §14.3）
# 默认模型 id 取自 2026-09-30 的官方文档快照；可在下列 *_MODEL 变量中覆盖
AIOS_OPENAI_API_KEY=
AIOS_OPENAI_BASE_URL=https://api.openai.com/v1
AIOS_OPENAI_MODEL=gpt-5.5
AIOS_ANTHROPIC_API_KEY=
AIOS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AIOS_ANTHROPIC_MODEL=claude-sonnet-5-5
AIOS_DEEPSEEK_API_KEY=
AIOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
AIOS_DEEPSEEK_MODEL=deepseek-flash

# HTTP 调用策略：上游失败 / 超时按 0.5s 起的指数退避重试
AIOS_MODEL_TIMEOUT_SECONDS=60
AIOS_MODEL_MAX_RETRIES=2

# 本地模型（Ollama / vLLM 等 OpenAI 兼容端点，M1 后续增量接入）
# 注意：AIOS_LOCAL_MODEL_NAME 必须写具体值，留空会覆盖掉 config 里的默认值 local-echo
AIOS_LOCAL_MODEL_NAME=local-echo
AIOS_LOCAL_MODEL_BASE_URL=

# 默认路由到的供应商：local / openai / anthropic / deepseek
AIOS_DEFAULT_PROVIDER=local
