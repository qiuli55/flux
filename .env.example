# Flux 环境变量模板
# 复制为 .env 后填写，且必须放在仓库根：backend/flux/config.py 固定读取仓库根 .env，
# 与启动目录无关（make run 从仓库根启动、make migrate 从 backend/ 启动，读到的是同一份）。
# .env 已在 .gitignore 中，不会被提交。
# 注意：真实密钥只写进本地 .env 或 Vault，禁止写入源码与文档（主规格 §14.3）。

# --- 应用 ---
FLUX_ENV=local
FLUX_LOG_LEVEL=INFO
FLUX_API_V1_PREFIX=/api/v1

# --- 存储 ---
# 生产：PostgreSQL（部署时使用 pgvector 镜像，见 docker-compose.yml）
FLUX_DATABASE_URL=postgresql+asyncpg://flux:flux@localhost:5432/flux
# 本地无 PostgreSQL 时可用 SQLite 跑通（迁移与测试均支持）
# FLUX_DATABASE_URL=sqlite+aiosqlite:///./flux.db
FLUX_REDIS_URL=redis://localhost:6379/0

# --- 模型供应商（留空表示未配置，该供应商不参与路由）---
# 密钥仅在被调用的 Provider 内部读取，不下发给 Agent（主规格 §14.3）
# 默认模型 id 取自 2026-09-30 的官方文档快照；可在下列 *_MODEL 变量中覆盖
FLUX_OPENAI_API_KEY=
FLUX_OPENAI_BASE_URL=https://api.openai.com/v1
FLUX_OPENAI_MODEL=gpt-5.5
FLUX_ANTHROPIC_API_KEY=
FLUX_ANTHROPIC_BASE_URL=https://api.anthropic.com
FLUX_ANTHROPIC_MODEL=claude-sonnet-5-5
FLUX_DEEPSEEK_API_KEY=
FLUX_DEEPSEEK_BASE_URL=https://api.deepseek.com
FLUX_DEEPSEEK_MODEL=deepseek-flash

# HTTP 调用策略：上游失败 / 超时按 0.5s 起的指数退避重试
FLUX_MODEL_TIMEOUT_SECONDS=60
FLUX_MODEL_MAX_RETRIES=2

# 本地模型（Ollama / vLLM 等 OpenAI 兼容端点，M1 后续增量接入）
# 注意：FLUX_LOCAL_MODEL_NAME 必须写具体值，留空会覆盖掉 config 里的默认值 local-echo
FLUX_LOCAL_MODEL_NAME=local-echo
FLUX_LOCAL_MODEL_BASE_URL=

# 默认路由到的供应商：local / openai / anthropic / deepseek
FLUX_DEFAULT_PROVIDER=local

# --- DSH Agent Runtime（内置 DeepSeek agent；集成方案 §17）---
# 默认关闭：未启用时 /dsh 接口返回 503，不会假装开始执行。
# 启用方式：按需覆盖下面各项（两个目录会在首次启动时自动创建），
# 再把 FLUX_DSH_ENABLED 改为 true 并重启后端；SDK 已在 requirements.txt 内，无需额外安装。
FLUX_DSH_ENABLED=false
# DSH_HOME：profiles / plugins / 会话与 MCP patch 落盘；必须在仓库外（patch 内含令牌明文）
# FLUX_DSH_HOME=/opt/flux/dsh-home
# Agent 工作目录（cwd）：Phase 1 用独立空目录，不指向真实项目
# FLUX_DSH_WORKSPACE=/opt/flux/dsh-ws
# provider 路由与模型 id
# FLUX_DSH_PROVIDER=deepseek-official
# FLUX_DSH_MODEL=deepseek-v4-flash
# 单次输出 token 上限
# FLUX_DSH_MAX_TOKENS=49152
# 初始化握手超时（秒）
# FLUX_DSH_INIT_TIMEOUT_SECONDS=30.0
# 单轮超时（秒）；0 表示不设限
# FLUX_DSH_RUN_TIMEOUT_SECONDS=0.0

# Run 生命周期看护（修复方案 §2.3~§2.7）：三类超时全部可关（0 = 关闭该判据）——
#   startup：进程起来但始终没进入 RUNNING 的上限
#   idle   ：进程还在、但既无输出也无 MCP 活动、状态也不变的上限
#   hard   ：无论有无输出都不放行的绝对上限
# FLUX_DSH_STARTUP_TIMEOUT_SECONDS=120
# FLUX_DSH_IDLE_TIMEOUT_SECONDS=600
# FLUX_DSH_HARD_TIMEOUT_SECONDS=1800
# 心跳周期（秒）：写 last_heartbeat_at 并检查三类超时 / 进程存活
# FLUX_DSH_HEARTBEAT_INTERVAL_SECONDS=5
# Reconciler 对账周期（秒）：数据库状态 ↔ 真实进程状态
# FLUX_DSH_RECONCILE_INTERVAL_SECONDS=10
# Cancel 优雅期（秒）：SIGTERM 进程组后等这么久，仍在则 SIGKILL
# FLUX_DSH_CANCEL_GRACE_SECONDS=5

# DSH × MCP 注入（目标架构 §3）：内置 Agent 只能经 MCP 看项目、提提案；
# 启动 DSH 时自动生成 patch 注入 MCP 客户端插件。
# 关闭后 DSH 会退化成"没有平台的裸 agent"——仅用于本地排查，默认必须开着。
# FLUX_DSH_MCP_ENABLED=true
# Flux MCP 端点（streamable-http）；隔离实例请显式指向自己的端口
# FLUX_DSH_MCP_URL=http://127.0.0.1:8000/mcp
# MCP serverName（注入后工具名形如 mcp__flux__workspace.read）
# FLUX_DSH_MCP_SERVER_NAME=flux
# 内置 Agent 的令牌身份：Flux 用它在 MCP 面盖章 provenance
# FLUX_DSH_MCP_AGENT_ID=flux-builtin
# 单次工具调用超时（毫秒）
# FLUX_DSH_MCP_TOOL_TIMEOUT_MS=60000

# --- Virtual Workspace Apply（主规格 §7.6）---
# Agent 改动的落盘根目录：必须是被改项目的根目录，Apply 只会写这个目录之内的相对路径。
# 留空表示未配置，此时 /workspace/apply 会直接报 422，绝不默认写到别的目录。
# 例：FLUX_WORKSPACE_ROOT=/home/meng/projects/my-service
FLUX_WORKSPACE_ROOT=
# Apply 落盘后要跑的测试命令；留空表示跳过测试。命令在 workspace_root 下执行。
# 例：FLUX_TEST_COMMAND=pytest -q
FLUX_TEST_COMMAND=
# 测试命令超时（秒）；超时视为测试失败，Apply 会回滚已写入的文件
FLUX_TEST_TIMEOUT_SECONDS=300

# --- Git 集成（主规格 §17.6；实施计划 ⑨）---
# git 命令超时（秒）。Git 操作与 Apply / Tester 一样只在 FLUX_WORKSPACE_ROOT 下执行，
# 且只做本地可回退的操作（status/diff/branch/checkout/commit），绝不 push / force / reset。
FLUX_GIT_TIMEOUT_SECONDS=30

# --- Project Scanner（主规格 §5.8；实施计划 ⑩）---
# 扫描上限：文件数与目录深度都必须有界。触顶时画像照常产出，但 truncated=true。
# 噪声目录（.git/.venv/node_modules/__pycache__/.flux/dist/build 等）一律跳过，不受这两项影响。
FLUX_PROJECT_SCAN_MAX_FILES=2000
FLUX_PROJECT_SCAN_MAX_DEPTH=6
